{
  // Emits the runtime-agnostic provider core (and the src files it imports) to dist/
  // so Node can load pi-claude-bridge/core without a TS loader.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "noEmit": false
  },
  "include": ["src/core/index.ts"]
}
