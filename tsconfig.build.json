{
  // Emits the stateless provider (and the src files it imports) to dist/ so Node can
  // load pi-claude-bridge/stateless without a TS loader.
  "extends": "./tsconfig.json",
  "compilerOptions": { "rootDir": "src", "outDir": "dist", "declaration": true, "noEmit": false },
  "include": ["src/stateless/index.ts"]
}
